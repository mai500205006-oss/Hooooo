# Example environment variables for Red King (foundation)

# Database connection used by the app (asyncpg)
DATABASE_URL=postgresql+asyncpg://redking:change_me@127.0.0.1:5432/redking_db

# Local Postgres settings (used by docker-compose when not overridden)
POSTGRES_USER=redking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=redking_db

# Do NOT commit real credentials. Copy this file to .env and edit locally.
